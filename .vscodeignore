# 打 .vsix 时排除的开发产物。
# 目标：装到用户机器上的只有运行必需的东西。

# 设计沙盘与截图 —— 只有开发期用
dev/**
docs/**

# 测试与固件 —— 用户不需要
test/**
*.test.js

# 仓库杂项
.gitignore
.vscodeignore
.github/**
.editorconfig

# 中文 README 不打包：市场只渲染 README.md，中文版放仓库里给人看
README.zh-CN.md

# LICENSE 和 CHANGELOG.md 要随包发：
# 市场会把 CHANGELOG 显示成一个标签页，LICENSE 是许可声明的实体文件
