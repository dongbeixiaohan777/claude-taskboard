{
  "name": "claude-taskboard",
  "displayName": "Claude Taskboard",
  "description": "A sidebar panel for your projects and Claude Code sessions: see what's alive, where your time went, and jump back to any past conversation.",
  "version": "0.1.0",
  "publisher": "dongbeixiaohan777",
  "license": "MIT",
  "private": false,
  "icon": "media/icon-128.png",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "taskboard",
    "sessions",
    "projects",
    "dashboard",
    "kanban"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dongbeixiaohan777/claude-taskboard.git"
  },
  "bugs": {
    "url": "https://github.com/dongbeixiaohan777/claude-taskboard/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:taskboard.main"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskboard",
          "title": "Claude Taskboard",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "taskboard": [
        {
          "type": "webview",
          "id": "taskboard.main",
          "name": "Claude Taskboard"
        }
      ]
    },
    "commands": [
      {
        "command": "taskboard.refresh",
        "title": "Refresh",
        "category": "Claude Taskboard",
        "icon": "$(refresh)"
      },
      {
        "command": "taskboard.toggle",
        "title": "Toggle Board / List",
        "category": "Claude Taskboard",
        "icon": "$(list-unordered)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskboard.toggle",
          "when": "view == taskboard.main",
          "group": "navigation@1"
        },
        {
          "command": "taskboard.refresh",
          "when": "view == taskboard.main",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude Taskboard",
      "properties": {
        "taskboard.glassEffect": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Enable the glass effect only with dark themes.",
            "Enable the glass effect with every theme.",
            "Disable the glass effect and always use the flat style."
          ],
          "default": "auto",
          "markdownDescription": "The panel's liquid glass effect.\n\n**auto** (default) — glass works best when it reveals content behind the panel. Dark themes provide stronger depth, while light themes can reduce the contrast between white cards and the background. This mode follows the active theme.\n\nChanges apply immediately; no reload is needed."
        },
        "taskboard.projectsDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Project documentation folder. Leave blank to automatically detect a common location in the current workspace, such as `KB/02-项目`, `projects`, or `docs/projects`."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}
